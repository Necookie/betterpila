---
import BaseLayout from "../layouts/BaseLayout.astro";
const record = Astro.url.searchParams.get("record") ?? "";
---

<BaseLayout
  title="Suggest a Correction — Better Pila"
  description="How to report inaccurate, outdated, or incomplete public records to the Better Pila editorial desk."
  noIndex
>
  <header class="page-hero">
    <div class="narrow">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Corrections</span>
      </div>
      <p class="eyebrow">Accuracy & Integrity</p>
      <h1>Help us keep the record true.</h1>
      <p class="lede">
        We strive for total factual accuracy. If any information on Better Pila is incorrect, incomplete, or out of date, report it with verifiable evidence.
      </p>
    </div>
  </header>

  <section class="section narrow">
    <article class="paper content">
      <div class="notice" style="margin-bottom: 2rem;">
        <strong>Notice:</strong> Better Pila does not handle emergency dispatches, official government complaints, or administrative municipal service requests. For emergencies, please call local municipal hotlines directly.
      </div>

      {record && (
        <div style="background: var(--paper-subtle); border: 1px solid var(--line-strong); border-left: 4px solid var(--gold); border-radius: var(--radius-sm); padding: 1rem 1.25rem; margin-bottom: 2rem;">
          <span style="font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 800; color: var(--gold-dark); font-family: var(--font-mono);">Target Accession Docket</span>
          <p style="margin: 0.35rem 0 0; font-family: var(--font-mono); font-size: 0.92rem; color: var(--navy-deep); font-weight: 700;">{record}</p>
        </div>
      )}

      <h2 style="color: var(--navy-deep); margin-bottom: 0.85rem;">What to include in a correction report</h2>
      <p>To help our volunteer editorial desk verify and correct records efficiently, please include:</p>
      <ul style="margin: 0 0 1.5rem; padding-left: 1.25rem; color: var(--ink-soft); display: grid; gap: 0.5rem; font-size: 0.95rem;">
        <li><strong>Docket / URL:</strong> The specific Better Pila record URL or document accession number.</li>
        <li><strong>Contested Information:</strong> The exact date, number, person, or statement requiring amendment.</li>
        <li><strong>Primary Source Evidence:</strong> A scanned copy, official Gazette volume, certified Municipal Resolution, or COA report citation.</li>
        <li><strong>Contact Information:</strong> A verified email address for our research desk to follow up. Personal submitter details are kept confidential.</li>
      </ul>

      <h2 style="color: var(--navy-deep); margin-top: 2rem; margin-bottom: 0.85rem;">Editorial Verification Lifecycle</h2>
      <ol style="margin: 0 0 1.5rem; padding-left: 1.25rem; color: var(--ink-soft); display: grid; gap: 0.6rem; font-size: 0.95rem;">
        <li><strong>Intake & Logging:</strong> The submission is logged in our public verification backlog with an accession timestamp.</li>
        <li><strong>Primary Cross-Checking:</strong> The submitted evidence is cross-referenced with municipal records, Sangguniang Bayan logs, and official gazettes.</li>
        <li><strong>Publication & Correction Notice:</strong> Once substantiated, the live record is updated and a visible revision note is appended to the audit ledger.</li>
      </ol>

      <div style="background: var(--paper-subtle); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.4rem; margin-top: 2rem;">
        <h3 style="margin: 0 0 0.4rem; font-family: var(--font-serif); font-size: 1.1rem; color: var(--navy-deep);">Public Submission Channels</h3>
        <p style="margin: 0; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.6;">
          Direct evidence and correction memoranda may be submitted via GitHub issues on our repository or sent to our editorial desk.
        </p>
      </div>

      <div style="margin-top: 2.2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); display: flex; gap: 0.8rem; flex-wrap: wrap;">
        <a href="/" class="button button-primary">← Return to homepage</a>
        <a href="/methodology" class="button button-secondary">Review verification methodology</a>
      </div>
    </article>
  </section>
</BaseLayout>
