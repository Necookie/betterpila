---
import BaseLayout from "../layouts/BaseLayout.astro";
import RecordCard from "../components/RecordCard.astro";
import { listPublishedRecords } from "../lib/database";
import { collectionMeta, recordTypes, type RecordType } from "../lib/types";

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const requestedType = Astro.url.searchParams.get("type") ?? "";
const type = recordTypes.includes(requestedType as RecordType) ? (requestedType as RecordType) : undefined;
const records = q || type ? await listPublishedRecords(type, q) : [];
---

<BaseLayout title="Search public records — Better Pila" description="Search verified Better Pila public records across all directories." noIndex>
  <header class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Search</span>
      </div>
      <p class="eyebrow">Search Records</p>
      <h1>Search Better Pila</h1>
      <p class="lede">Explore verified municipal records across officials, public offices, annual budgets, infrastructure projects, ordinances, and resolutions.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <!-- Category Switcher Chips -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem;" aria-label="Quick directory filters">
        <a
          href={`/search${q ? `?q=${encodeURIComponent(q)}` : ""}`}
          class={!type ? "button button-primary" : "button button-secondary"}
          style="min-height: 34px; padding: 0.35rem 0.8rem; font-size: 0.82rem;"
        >
          All Directories
        </a>
        {recordTypes.map((item) => (
          <a
            href={`/search?type=${item}${q ? `&q=${encodeURIComponent(q)}` : ""}`}
            class={item === type ? "button button-primary" : "button button-secondary"}
            style="min-height: 34px; padding: 0.35rem 0.8rem; font-size: 0.82rem;"
          >
            {collectionMeta[item].plural}
          </a>
        ))}
      </div>

      <!-- Search Form -->
      <form class="toolbar" method="get" role="search" style="margin-bottom: 1.8rem;">
        <div class="field field-grow">
          <label for="q">Search terms</label>
          <input
            id="q"
            name="q"
            type="search"
            value={q}
            placeholder="Search by name, position, document number, barangay, or keyword…"
            autofocus
          />
        </div>
        <div class="field">
          <label for="type">Category filter</label>
          <select id="type" name="type">
            <option value="">All directories</option>
            {recordTypes.map((item) => (
              <option value={item} selected={item === type}>{collectionMeta[item].plural}</option>
            ))}
          </select>
        </div>
        <button class="button button-primary" type="submit">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span>Search</span>
        </button>
        {(q || type) && (
          <a href="/search" class="button button-secondary">Clear</a>
        )}
      </form>

      <!-- Quick query suggestion tags -->
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 2rem; font-size: 0.82rem; color: var(--ink-muted);">
        <span style="font-weight: 600;">Suggestions:</span>
        <a href="/search?q=Sangguniang+Bayan" class="search-tag-link" style="color: var(--ink-soft); background: var(--paper-subtle); border-color: var(--line);">Sangguniang Bayan</a>
        <a href="/search?q=Mayor" class="search-tag-link" style="color: var(--ink-soft); background: var(--paper-subtle); border-color: var(--line);">Mayor's Office</a>
        <a href="/search?q=Budget" class="search-tag-link" style="color: var(--ink-soft); background: var(--paper-subtle); border-color: var(--line);">Annual Budget</a>
        <a href="/search?q=Health" class="search-tag-link" style="color: var(--ink-soft); background: var(--paper-subtle); border-color: var(--line);">Health Office</a>
        <a href="/search?q=Ordinance" class="search-tag-link" style="color: var(--ink-soft); background: var(--paper-subtle); border-color: var(--line);">Municipal Ordinances</a>
      </div>

      {q || type ? (
        records.length > 0 ? (
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
              <p style="margin: 0; font-size: 0.95rem; color: var(--ink-soft); font-weight: 600;">
                Found {records.length} verified {records.length === 1 ? "record" : "records"}
                {q && <span> for <strong>"{q}"</strong></span>}
                {type && <span> in <strong>{collectionMeta[type].plural}</strong></span>}
              </p>
            </div>
            <div class="records">
              {records.map((record) => <RecordCard record={record} />)}
            </div>
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-state-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <h2>No verified records found</h2>
            <p>
              We couldn't find any verified records matching your query. Better Pila only displays information with confirmed primary sources.
            </p>
            <div style="margin-top: 1.5rem; display: flex; justify-content: center; gap: 0.75rem;">
              <a class="button button-primary" href="/search">Clear search filters</a>
              <a class="button button-secondary" href="/">Browse all directories</a>
            </div>
          </div>
        )
      ) : (
        <div class="empty-state">
          <div class="empty-state-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 21l-4.35-4.35M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0z"></path>
            </svg>
          </div>
          <h2>Search verified public records</h2>
          <p>
            Enter keywords or an official's name above to search across our civic archive. Only reviewed and published records are included in search results.
          </p>
          <div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem;">
            <span style="font-size: 0.85rem; color: var(--ink-soft); align-self: center; margin-right: 0.25rem;">Explore:</span>
            {recordTypes.map((t) => (
              <a href={`/search?type=${t}`} class="button button-secondary" style="min-height: 34px; padding: 0.35rem 0.75rem; font-size: 0.82rem;">
                {collectionMeta[t].plural}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
