import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Privacy — Better Pila" description="Better Pila privacy commitments.">
  <header class="page-hero"><div class="narrow"><div class="breadcrumb"><a href="/">Home</a><span>/</span><span>Privacy</span></div><p class="eyebrow">Data minimization</p><h1>Collect less. Protect what remains.</h1></div></header>
  <article class="section narrow content paper">
    <h2>Current collection</h2><p>The initial public portal does not offer public accounts, advertising, or an open submission form. Operational logs may contain basic request information needed to keep the service reliable and secure.</p>
    <h2>Public records</h2><p>Better Pila publishes legitimate public-interest information and official public-contact details. It does not intentionally publish private addresses, personal phone numbers, identity numbers, signatures, or unrelated personal information.</p>
    <h2>Future forms and analytics</h2><p>This notice will be updated before a correction form or analytics is enabled. Optional contact information will be retained only as long as needed to resolve the request.</p>
  </article>
</BaseLayout>

