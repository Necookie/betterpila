---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Better Pila — Public information, clearly sourced",
  description = "Independent access to sourced public information about Pila, Laguna.",
  canonicalPath = Astro.url.pathname,
  noIndex = false,
  structuredData,
} = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(canonicalPath, siteUrl).toString();
const currentSection = Astro.url.pathname.split("/")[1];
const nav = [
  ["Officials", "/officials", "officials"],
  ["Offices", "/offices", "offices"],
  ["Budgets", "/budgets", "budgets"],
  ["Projects", "/projects", "projects"],
  ["Ordinances", "/ordinances", "ordinances"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b2847" />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Better Pila" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="topline">
        <div class="container">
          <span>Independent civic transparency portal</span>
          <span>Not an official Municipality of Pila website</span>
        </div>
      </div>
      <div class="container header-main">
        <a class="brand" href="/" aria-label="Better Pila home">
          <span class="brand-mark" aria-hidden="true">BP</span>
          <span>Better Pila</span>
        </a>
        <nav class="nav desktop-nav" aria-label="Primary navigation">
          {nav.map(([label, href, section]) => (
            <a href={href} aria-current={currentSection === section ? "page" : undefined}>{label}</a>
          ))}
          <a href="/search">Search</a>
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav class="mobile-links" aria-label="Mobile navigation">
            {nav.map(([label, href]) => <a href={href}>{label}</a>)}
            <a href="/resolutions">Resolutions</a>
            <a href="/search">Search</a>
            <a href="/about">About</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <section>
          <h2>Better Pila</h2>
          <p>Independent, source-first access to public information about Pila, Laguna. This project is not owned, endorsed, or operated by the municipal government.</p>
        </section>
        <section>
          <h2>Project</h2>
          <nav aria-label="Project information">
            <a href="/about">About</a>
            <a href="/methodology">Methodology</a>
            <a href="/corrections">Corrections</a>
          </nav>
        </section>
        <section>
          <h2>Policies</h2>
          <nav aria-label="Policies">
            <a href="/accessibility">Accessibility</a>
            <a href="/privacy">Privacy</a>
            <a href="/sitemap.xml">Sitemap</a>
          </nav>
        </section>
      </div>
      <div class="container footer-bottom">Public information deserves a clear source and a visible verification date.</div>
    </footer>
  </body>
</html>
