---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Better Pila — Public information, clearly sourced",
  description = "Independent access to sourced public information about Pila, Laguna.",
  canonicalPath = Astro.url.pathname,
  noIndex = false,
  structuredData,
} = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(canonicalPath, siteUrl).toString();
const currentSection = Astro.url.pathname.split("/")[1];
const nav = [
  ["Officials", "/officials", "officials"],
  ["Offices", "/offices", "offices"],
  ["Budgets", "/budgets", "budgets"],
  ["Projects", "/projects", "projects"],
  ["Ordinances", "/ordinances", "ordinances"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a2239" />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Better Pila" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="topline">
        <div class="container">
          <div class="topline-left">
            <span style="font-weight: 700; color: #fde68a;">Bayan ng Pila, Laguna</span>
            <span class="topline-sep" aria-hidden="true">·</span>
            <span>National Historical Landmark Town</span>
            <span class="topline-sep" aria-hidden="true">·</span>
            <span class="pst-clock" title="Philippine Standard Time">PST UTC+8</span>
          </div>
          <div class="topline-right">
            <span>Pila, Laguna · Public information, sourced independently</span>
            <span class="topline-sep" aria-hidden="true">·</span>
            <a href="/methodology" class="topline-link">Verification Standard</a>
          </div>
        </div>
      </div>
      <div class="container header-main">
        <a class="brand" href="/" aria-label="Better Pila home">
          <span class="brand-mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M12 8v4"/>
              <path d="M12 16h.01"/>
            </svg>
          </span>
          <div class="brand-text">
            <span class="brand-title">Better Pila</span>
            <span class="brand-subtitle">Civic Public Record · Bayan ng Pila</span>
          </div>
        </a>
        <nav class="nav desktop-nav" aria-label="Primary navigation">
          {nav.map(([label, href, section]) => (
            <a href={href} aria-current={currentSection === section ? "page" : undefined}>{label}</a>
          ))}
          <a href="/resolutions" aria-current={currentSection === "resolutions" ? "page" : undefined}>Resolutions</a>
          <a href="/search" class="nav-search-btn" aria-label="Search records">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span>Search</span>
            <kbd aria-hidden="true">/</kbd>
          </a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="Open main menu">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
            <span>Menu</span>
          </summary>
          <nav class="mobile-links" aria-label="Mobile navigation">
            {nav.map(([label, href]) => (
              <a href={href}>
                <span>{label}</span>
                <span aria-hidden="true" style="color: #94a3b8;">→</span>
              </a>
            ))}
            <a href="/resolutions">
              <span>Resolutions</span>
              <span aria-hidden="true" style="color: #94a3b8;">→</span>
            </a>
            <a href="/search">
              <span>Search Records</span>
              <span aria-hidden="true" style="color: #94a3b8;">🔍</span>
            </a>
            <a href="/about">
              <span>About Better Pila</span>
              <span aria-hidden="true" style="color: #94a3b8;">ℹ️</span>
            </a>
            <a href="/corrections">
              <span>Report a Correction</span>
              <span aria-hidden="true" style="color: #94a3b8;">✍️</span>
            </a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <section>
          <h2>Better Pila</h2>
          <p>An independent and source-first civic transparency portal for Pila, Laguna. Providing clear access to verified public documents, leadership directories, municipal budgets, and local ordinances.</p>
          <div style="margin-top: 1.2rem; display: inline-flex; align-items: center; gap: 0.55rem; background: rgb(255 255 255 / 0.06); padding: 0.45rem 0.85rem; border-radius: 9999px; font-size: 0.78rem; border: 1px solid rgb(255 255 255 / 0.1);">
            <span class="pulse-dot" aria-hidden="true"></span>
            <span>Independent Non-Governmental Registry</span>
          </div>
        </section>
        <section>
          <h2>Civic Directories</h2>
          <nav aria-label="Directories">
            <a href="/officials">Municipal Officials</a>
            <a href="/offices">Offices & Contacts</a>
            <a href="/budgets">Municipal Budgets</a>
            <a href="/projects">Public Projects</a>
            <a href="/ordinances">Ordinances & Codes</a>
            <a href="/resolutions">Council Resolutions</a>
          </nav>
        </section>
        <section>
          <h2>Governance & Trust</h2>
          <nav aria-label="Governance">
            <a href="/about">About Better Pila</a>
            <a href="/methodology">Research Methodology</a>
            <a href="/corrections">Report a Correction</a>
            <a href="/accessibility">Accessibility Commitment</a>
            <a href="/privacy">Privacy Notice</a>
            <a href="/sitemap.xml">XML Sitemap</a>
          </nav>
        </section>
      </div>
      <div class="container footer-bottom">
        <div>Public records deserve an authentic source and a visible verification timestamp.</div>
        <div>Pila, Laguna, Philippines · Bayan ng Pila Civic Archive</div>
      </div>
    </footer>
    <script is:inline>
      document.addEventListener("keydown", (e) => {
        if (e.key === "/" && !["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName || "")) {
          e.preventDefault();
          const searchInput = document.querySelector('input[type="search"]');
          if (searchInput) {
            searchInput.focus();
            searchInput.select?.();
          } else {
            window.location.href = "/search";
          }
        }
      });
    </script>
  </body>
</html>
